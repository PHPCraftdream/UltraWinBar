<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <None Update="UltraWinBar.defaults.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../UltraWinBar/Languages/English.xaml" Link="Localization/English.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../UltraWinBar/Languages/беларуская.xaml" Link="Localization/Belarusian.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../UltraWinBar/Themes/*.xaml" Link="Themes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../UltraWinBar/Resources/*" Link="Resources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../UltraWinBar/PropertiesWindow.xaml" Link="Layout/PropertiesWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="UltraWinBar"><HintPath>../../UltraWinBar/bin/Debug/net6.0-windows/UltraWinBar.dll</HintPath></Reference>
    <Reference Include="ManagedShell.AppBar"><HintPath>../../UltraWinBar/bin/Debug/net6.0-windows/ManagedShell.AppBar.dll</HintPath></Reference>
    <Reference Include="ManagedShell.Interop"><HintPath>../../UltraWinBar/bin/Debug/net6.0-windows/ManagedShell.Interop.dll</HintPath></Reference>
  </ItemGroup>
</Project>
