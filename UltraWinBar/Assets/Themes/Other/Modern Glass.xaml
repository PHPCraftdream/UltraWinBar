<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <!-- Modern Glass: slate surfaces tinted with a neon accent, glass layers (flat translucent colors over the base),
         and the blurred desktop behind the panel and the windows. Colors are the Tailwind CSS palette (MIT).
         Everything here is a flat brush: no gradients, no Effect, no animations; the only layered window is the
         panel (the AllowsTransparency key below), which the blur behind it needs. The keys below are the defaults
         (cyan, opaque); ModernTheme.Apply replaces them with the accent chosen in the settings and, when the blur
         is on, with translucent ones. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/UltraWinBar;component/Assets/Resources/Brand/ModernControls.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UltraWinBar;component/Assets/Resources/Brand/ModernMenus.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Taller than the base 28 (the horizontal panel looked cut off): 40 px at the panel scale 1.2. -->
    <system:Double x:Key="TaskbarHeight">33.34</system:Double>

    <!-- Base: slate-950 / 900 / 800 tinted with the accent (14, 10 and 20 percent), and text slate-50 / 200 / 400 / 500 -->
    <SolidColorBrush x:Key="ModernBaseDeep" Color="#051A2C" />
    <SolidColorBrush x:Key="ModernBase" Color="#123145" />
    <SolidColorBrush x:Key="ModernRaised" Color="#1F4B5F" />
    <SolidColorBrush x:Key="ModernInput" Color="#99051A2C" />
    <SolidColorBrush x:Key="ModernWindowFill" Color="#123145" />
    <SolidColorBrush x:Key="ModernTextStrong" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ModernText" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ModernTextMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="ModernTextFaint" Color="#64748B" />

    <!-- Glass: the accent at 8 / 15 / 22 percent over the base, hairlines of it at 25 / 45 percent -->
    <SolidColorBrush x:Key="ModernGlass" Color="#1422D3EE" />
    <SolidColorBrush x:Key="ModernGlassHover" Color="#2622D3EE" />
    <SolidColorBrush x:Key="ModernGlassPressed" Color="#3822D3EE" />
    <SolidColorBrush x:Key="ModernGlassBorder" Color="#4022D3EE" />
    <SolidColorBrush x:Key="ModernGlassBorderStrong" Color="#7322D3EE" />
    <SolidColorBrush x:Key="ListRowHover" Color="#2622D3EE" />
    <SolidColorBrush x:Key="ListRowHoverEdge" Color="#6622D3EE" />

    <!-- Accent (neon): cyan-400 and 500; glow rings at 25 / 12 / 6 percent; soft fill at 16 percent -->
    <SolidColorBrush x:Key="ModernAccent" Color="#22D3EE" />
    <SolidColorBrush x:Key="ModernAccentStrong" Color="#06B6D4" />
    <SolidColorBrush x:Key="ModernAccentGlow1" Color="#4022D3EE" />
    <SolidColorBrush x:Key="ModernAccentGlow2" Color="#1F22D3EE" />
    <SolidColorBrush x:Key="ModernAccentGlow3" Color="#0F22D3EE" />
    <SolidColorBrush x:Key="ModernAccentSoft" Color="#2922D3EE" />
    <SolidColorBrush x:Key="ModernAccentText" Color="#020617" />

    <!-- Plain Windows controls that have no template of their own follow the same colors -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#123145" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E2E8F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1F4B5F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E2E8F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#305E74" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#406E84" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#305E74" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#1F4B5F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#64748B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#06B6D4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#020617" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E2E8F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="#22D3EE" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#123145" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E2E8F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#123145" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#1F4B5F" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#E2E8F0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#1F4B5F" />
    <Color x:Key="{x:Static SystemColors.WindowColorKey}">#123145</Color>
    <Color x:Key="{x:Static SystemColors.WindowTextColorKey}">#E2E8F0</Color>
    <Color x:Key="{x:Static SystemColors.ControlColorKey}">#1F4B5F</Color>
    <Color x:Key="{x:Static SystemColors.ControlTextColorKey}">#E2E8F0</Color>
    <Color x:Key="{x:Static SystemColors.ControlLightColorKey}">#305E74</Color>
    <Color x:Key="{x:Static SystemColors.ControlDarkColorKey}">#305E74</Color>
    <Color x:Key="{x:Static SystemColors.GrayTextColorKey}">#64748B</Color>

    <!-- The panel: the base color is the panel, task buttons are a glass layer over it -->
    <system:Boolean x:Key="AllowsTransparency">True</system:Boolean>
    <system:Double x:Key="GlobalFontSize">12</system:Double>
    <FontFamily x:Key="GlobalFontFamily">Segoe UI</FontFamily>

    <SolidColorBrush x:Key="ButtonFace" Color="#12394D" />
    <SolidColorBrush x:Key="TaskbarBackground" Color="#12394D" />
    <SolidColorBrush x:Key="TaskButtonBackground" Color="#2222D3EE" />
    <SolidColorBrush x:Key="ButtonFlashingFace" Color="#6622D3EE" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ButtonFlashingForeground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ClockForeground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="InputLanguageForeground" Color="#020617" />
    <SolidColorBrush x:Key="InputLanguageBackground" Color="#22D3EE" />
    <SolidColorBrush x:Key="InputLanguageSelectorForeground" Color="#020617" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#1F4B5F" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#E2E8F0" />

    <!-- A window that draws its own title bar (the calendar): only the colors. -->
    <Style TargetType="Window" x:Key="OwnTitleWindow" BasedOn="{StaticResource GlobalFonts}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <!-- The windows' text has the panel's weight (semibold in the light theme: text over the glass is grayscale). -->
        <Setter Property="FontWeight" Value="{DynamicResource PanelFontWeight}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Background" Value="{DynamicResource ModernWindowFill}" />
        <Setter Property="Foreground" Value="{DynamicResource ModernText}" />
    </Style>

    <!-- The close button of the title bar. -->
    <Style TargetType="Button" x:Key="ModernCaptionClose">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource ModernTextStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" Width="46" Background="Transparent">
                        <TextBlock Text="&#x2715;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#CCE11D48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dialog draws its own title bar: the system one is GDI, whose text shows on a black box over the glass. The bar
         is solid and dark, its text light with a dark shadow (a second text one pixel lower; the theme has no effects). -->
    <Style TargetType="Window" x:Key="PropertiesWindow" BasedOn="{StaticResource OwnTitleWindow}">
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ModernGlassBorderStrong}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Height="34" Background="{DynamicResource ModernBaseDeep}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource ModernCaptionClose}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                                <Border DockPanel.Dock="Left" Width="3" Height="14" Margin="12,0,8,0" CornerRadius="2" Background="{DynamicResource ModernAccent}" />
                                <Grid VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Title}" Margin="1,1,0,0" Foreground="#E6000000" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{TemplateBinding Title}" Foreground="{DynamicResource ModernTextStrong}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DockPanel>
                            <AdornerDecorator>
                                <ContentPresenter />
                            </AdornerDecorator>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The panel is a layered window; its own fill (FlatPanelFill) is what is seen, over the blur. -->
    <Style TargetType="Window" x:Key="TaskbarWindow" BasedOn="{StaticResource TaskbarWindow}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Menu items that the panel gives a style of their own: keep the theme's menu look (BasedOn the implicit item style). -->
    <Style TargetType="MenuItem" x:Key="TaskManMenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="{DynamicResource show_taskman_2k}" />
    </Style>
    <Style TargetType="MenuItem" x:Key="ShowDesktopItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Header" Value="{DynamicResource show_desktop}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="ContentControl" x:Key="TaskButtonThumbnail">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border BorderThickness="1" BorderBrush="{DynamicResource ModernGlassBorderStrong}" Background="{DynamicResource ModernBase}" CornerRadius="8" Padding="4" Margin="4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
