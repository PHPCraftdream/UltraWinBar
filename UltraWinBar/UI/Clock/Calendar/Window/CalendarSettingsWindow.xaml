<Window x:Class="UltraWinBar.CalendarSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource calendar_settings_title}"
        Height="700"
        Width="560"
        MinHeight="480"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{DynamicResource flow_direction}"
        Style="{DynamicResource PropertiesWindow}">
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight"
                        Value="21" />
                <Setter Property="MinWidth"
                        Value="73" />
                <Setter Property="Padding"
                        Value="10,0" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="9,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Label Content="{DynamicResource calendar_settings_place}" />
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource hebrew_place_clear}"
                        Margin="6,0,0,0"
                        Click="PlaceClear_Click" />
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource hebrew_place_choose}"
                        Margin="6,0,0,0"
                        Click="PlaceChoose_Click" />
                <TextBlock x:Name="PlaceText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock Text="{DynamicResource hebrew_place_hint}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0">
            <Label Content="{DynamicResource calendar_settings_zone}"
                   Target="{Binding ElementName=ZoneBox}" />
            <ComboBox x:Name="ZoneBox"
                      DisplayMemberPath="Display"
                      SelectionChanged="Zone_SelectionChanged" />
        </StackPanel>
        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="{DynamicResource calendar_settings_yahrzeits}"
                   Target="{Binding ElementName=YahrzeitTree}" />
            <TreeView x:Name="YahrzeitTree"
                      Grid.Row="1">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}"
                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded"
                                Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <CheckBox IsThreeState="True"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Content="{Binding Text}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{DynamicResource calendar_close}"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
