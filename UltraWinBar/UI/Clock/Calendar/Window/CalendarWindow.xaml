<Window x:Class="UltraWinBar.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:calendar="clr-namespace:UltraWinBar.Utilities"
        Title="{DynamicResource calendar_title}"
        FontSize="15"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="{DynamicResource flow_direction}"
        Style="{DynamicResource OwnTitleWindow}"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UltraWinBar;component/UI/Clock/Calendar/CalendarIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="OmerVisibility" />
            <Style x:Key="CaptionButton"
                   TargetType="{x:Type Button}">
                <Setter Property="OverridesDefaultStyle"
                        Value="True" />
                <Setter Property="Focusable"
                        Value="False" />
                <Setter Property="Width"
                        Value="46" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Surface"
                                            Property="Background"
                                            Value="#80F43F5E" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Surface"
                                            Property="Background"
                                            Value="#B3F43F5E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DetailRow"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="6" />
                <Setter Property="Padding"
                        Value="10,6" />
                <Setter Property="Margin"
                        Value="0,1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource ListRowHover}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource ListRowHoverEdge}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight"
                        Value="32" />
                <Setter Property="MinWidth"
                        Value="44" />
                <Setter Property="Padding"
                        Value="10,0" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
            <!-- The Chrome mark drawn in one color (the text's): a ring, the inner circle and its three spokes. -->
            <Canvas x:Key="ChromeIcon"
                    x:Shared="False"
                    Width="16"
                    Height="16">
                <Ellipse Canvas.Left="1"
                         Canvas.Top="1"
                         Width="14"
                         Height="14"
                         StrokeThickness="1.4"
                         Stroke="{DynamicResource ModernText}" />
                <Ellipse Canvas.Left="5"
                         Canvas.Top="5"
                         Width="6"
                         Height="6"
                         StrokeThickness="1.4"
                         Stroke="{DynamicResource ModernText}" />
                <Path Data="M8,5 L14.32,5 M10.6,9.5 L7.44,14.97 M5.4,9.5 L2.24,4.03"
                      StrokeThickness="1.4"
                      Stroke="{DynamicResource ModernText}" />
            </Canvas>
            <!-- A small borderless button of a row: copy the name, look it up. -->
            <Style x:Key="RowIconButton"
                   TargetType="{x:Type Button}">
                <Setter Property="OverridesDefaultStyle"
                        Value="True" />
                <Setter Property="Focusable"
                        Value="False" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="Foreground"
                        Value="{DynamicResource ModernText}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Back"
                                    Width="24"
                                    Height="22"
                                    Margin="2,0,0,0"
                                    CornerRadius="4"
                                    Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Back"
                                            Property="Background"
                                            Value="{DynamicResource ModernGlassHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Back"
                                            Property="Background"
                                            Value="{DynamicResource ModernGlassPressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource ModernGlass}"
            BorderBrush="{DynamicResource ModernGlassBorder}"
            BorderThickness="0,0,0,1">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CaptionButton}"
                    Content="&#x2715;"
                    ToolTip="{DynamicResource calendar_close}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Close_Click" />
            <!-- The settings: a gear beside the close button (Segoe MDL2 Assets, the Windows icon font). -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE713;"
                    FontFamily="Segoe MDL2 Assets"
                    ToolTip="{DynamicResource calendar_settings}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Settings_Click" />
            <Border DockPanel.Dock="Left"
                    Width="3"
                    Height="14"
                    Margin="12,0,8,0"
                    CornerRadius="2"
                    Background="{DynamicResource ModernAccent}" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Border>
    <Grid Grid.Row="1"
          Margin="9,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="520" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>
        <!-- The month row, over the whole width: the civil month by the left arrow, the Hebrew ones by the right,
             the chosen day's Hebrew date and its week's portion in the middle. -->
        <DockPanel Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,10">
            <Button x:Name="PreviousButton"
                    DockPanel.Dock="Left"
                    Content="&#x25C0;"
                    ToolTip="{DynamicResource calendar_previous_month}"
                    Click="Previous_Click" />
            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    Content="&#x25B6;"
                    ToolTip="{DynamicResource calendar_next_month}"
                    Click="Next_Click" />
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource calendar_today}"
                    Margin="0,0,6,0"
                    Click="Today_Click" />
            <!-- Civil months or Hebrew ones in the grid; it names the other kind. -->
            <Button x:Name="GridSwitch"
                    DockPanel.Dock="Right"
                    Margin="0,0,6,0"
                    Click="GridSwitch_Click" />
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonthTitle"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="20"
                           FontWeight="Bold" />
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PortionTitle"
                               HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="HebrewMonthTitle"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FlowDirection="LeftToRight"
                           FontSize="20"
                           FontWeight="Bold" />
            </Grid>
        </DockPanel>
        <!-- The weekday numbers have a row of their own, so the day cards and the details on the right start on one line. -->
        <UniformGrid x:Name="WeekdayHeader"
                     Grid.Row="1"
                     Grid.Column="0"
                     Columns="7" />
        <Grid Grid.Row="2"
              Grid.Column="0">
            <ListBox x:Name="MonthList"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="MonthList_SelectionChanged"
                     PreviewKeyDown="MonthList_PreviewKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <calendar:WeekRowsPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="Margin"
                                Value="1" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Each day is a card of its own: a light glass fill, a thin border and rounded corners. -->
                        <Border x:Name="Cell"
                                MinHeight="70"
                                Margin="2"
                                CornerRadius="6"
                                BorderThickness="1"
                                Background="{DynamicResource ModernGlass}"
                                BorderBrush="{DynamicResource ModernGlassBorder}"
                                Padding="6,4">
                            <!-- The tooltip: the day's lines, and during the Omer its day and sefira after the tree of the sefirot. -->
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Tooltip}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding HasOmer, Converter={StaticResource OmerVisibility}}">
                                            <Viewbox Height="18" Margin="0,0,4,0" VerticalAlignment="Center">
                                                <ContentControl Focusable="False" Content="{DynamicResource OmerIcon}" />
                                            </Viewbox>
                                            <TextBlock Text="{Binding OmerText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- After sunset: the lower right half of the day that is ending and the upper left half of the
                                     day that has begun are shaded, a parallelogram across the two cells. -->
                                <Polygon x:Name="EveningEndShade"
                                         Grid.RowSpan="3"
                                         Margin="-7,-5"
                                         Points="1,0 1,1 0,1"
                                         Stretch="Fill"
                                         Fill="#38000000"
                                         IsHitTestVisible="False"
                                         Visibility="Collapsed" />
                                <Polygon x:Name="EveningBeginShade"
                                         Grid.RowSpan="3"
                                         Margin="-7,-5"
                                         Points="0,0 1,0 0,1"
                                         Stretch="Fill"
                                         Fill="#38000000"
                                         IsHitTestVisible="False"
                                         Visibility="Collapsed" />
                                <!-- The Hebrew date at the top right, the civil one at the bottom left (muted); between them the
                                     week's portion as an accent badge and the special days as blocks colored by their kind. -->
                                <!-- At the top left: a memorial candle on a yahrzeit, and during the Omer the tree of the sefirot
                                     with the day of the count, after the candle or in its place. -->
                                <!-- In the top row only: the row grows to the icons, so they never run into the blocks below. -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="-2,-2,0,2"
                                            IsHitTestVisible="False">
                                    <ContentControl x:Name="YahrzeitCandle"
                                                    Focusable="False"
                                                    Content="{StaticResource YahrzeitCandleIcon}"
                                                    Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal"
                                                Margin="3,0,0,0"
                                                Visibility="{Binding HasOmer, Converter={StaticResource OmerVisibility}}">
                                        <ContentControl Focusable="False"
                                                        Content="{DynamicResource OmerIcon}" />
                                        <TextBlock Text="{Binding Omer}"
                                                   Margin="3,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ModernTextStrong}"
                                                   FontSize="14"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Row="0"
                                           HorizontalAlignment="Right"
                                           Text="{Binding HebrewLabel}"
                                           Foreground="{DynamicResource ModernTextStrong}"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <StackPanel Grid.Row="1"
                                            Margin="0,3"
                                            VerticalAlignment="Top">
                                    <Border x:Name="PortionBadge"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,2"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="{DynamicResource ModernAccent}">
                                        <!-- A solid accent badge: readable on a selected (accent-tinted) cell too. -->
                                        <TextBlock Text="{Binding Portion}"
                                                   Foreground="{DynamicResource ModernAccentText}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Events}"
                                                  Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Chip"
                                                        Margin="0,0,0,2"
                                                        Padding="6,1"
                                                        CornerRadius="4"
                                                        Background="#2E38BDF8"
                                                        BorderBrush="#9938BDF8"
                                                        BorderThickness="2,0,0,0">
                                                    <TextBlock x:Name="ChipText"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource ModernTextStrong}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="YomTov">
                                                        <Setter TargetName="Chip" Property="Background" Value="#38FB7185" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#CCFB7185" />
                                                        <Setter TargetName="ChipText" Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="CholHamoed">
                                                        <Setter TargetName="Chip" Property="Background" Value="#26FB7185" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#99FB7185" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Fast">
                                                        <Setter TargetName="Chip" Property="Background" Value="#2694A3B8" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#9994A3B8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Minor">
                                                        <Setter TargetName="Chip" Property="Background" Value="#2EFBBF24" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#B3FBBF24" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <DockPanel Grid.Row="2">
                                    <TextBlock HorizontalAlignment="Left"
                                               Text="{Binding GregorianLabel}"
                                               Foreground="{DynamicResource ModernText}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </DockPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <!-- The day under the pointer stands out clearly, low weeks included. -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                         Value="True">
                                <Setter TargetName="Cell"
                                        Property="Background"
                                        Value="{DynamicResource ModernGlassHover}" />
                                <Setter TargetName="Cell"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ModernGlassBorderStrong}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OutsideMonth}"
                                         Value="True">
                                <Setter TargetName="Cell"
                                        Property="Opacity"
                                        Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}"
                                         Value="True">
                                <!-- Today stands out: a thick accent frame and the accent's soft fill. -->
                                <Setter TargetName="Cell"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ModernAccent}" />
                                <Setter TargetName="Cell"
                                        Property="BorderThickness"
                                        Value="3" />
                                <Setter TargetName="Cell"
                                        Property="Background"
                                        Value="{DynamicResource ModernAccentSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EveningEnds}"
                                         Value="True">
                                <Setter TargetName="EveningEndShade"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="Cell"
                                        Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource {x:Static SystemColors.HotTrackColorKey}}"
                                                         Opacity="0.6" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding EveningBegins}"
                                         Value="True">
                                <Setter TargetName="EveningBeginShade"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Portion}"
                                         Value="{x:Null}">
                                <Setter TargetName="PortionBadge"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasYahrzeit}"
                                         Value="True">
                                <Setter TargetName="YahrzeitCandle"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <!-- Top margin: the list's border and padding and the cards' own margins (1 + 2 + 1 + 2), so the first detail
             card's top is the first day card's top. -->
        <ScrollViewer Grid.Row="2"
                      Grid.Column="1"
                      Margin="10,6,0,0"
                      VerticalScrollBarVisibility="Auto">
            <!-- The day's details (the times of the day, yahrzeits, Omer) in a larger font than the grid's. -->
            <StackPanel x:Name="Details"
                        TextElement.FontSize="17" />
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
