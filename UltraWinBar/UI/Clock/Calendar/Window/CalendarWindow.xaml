<Window x:Class="UltraWinBar.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource calendar_title}"
        Height="580"
        Width="880"
        MinHeight="460"
        MinWidth="720"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource flow_direction}"
        Style="{DynamicResource PropertiesWindow}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight"
                        Value="21" />
                <Setter Property="MinWidth"
                        Value="30" />
                <Setter Property="Padding"
                        Value="10,0" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="9,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="400" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0"
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0"
                       Margin="0,0,0,6">
                <Button x:Name="PreviousButton"
                        DockPanel.Dock="Left"
                        Content="&#x25C0;"
                        ToolTip="{DynamicResource calendar_previous_month}"
                        Click="Previous_Click" />
                <Button x:Name="NextButton"
                        DockPanel.Dock="Right"
                        Content="&#x25B6;"
                        ToolTip="{DynamicResource calendar_next_month}"
                        Click="Next_Click" />
                <Button DockPanel.Dock="Right"
                        Content="{DynamicResource calendar_today}"
                        Margin="0,0,6,0"
                        Click="Today_Click" />
                <TextBlock x:Name="MonthTitle"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontWeight="Bold" />
            </DockPanel>
            <UniformGrid x:Name="WeekdayHeader"
                         Grid.Row="1"
                         Columns="7" />
            <ListBox x:Name="MonthList"
                     Grid.Row="2"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="MonthList_SelectionChanged"
                     PreviewKeyDown="MonthList_PreviewKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"
                                     Rows="6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="Margin"
                                Value="1" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Cell"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="3,2"
                                ToolTip="{Binding Tooltip}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding HebrewNumber}"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding GregorianNumber}" />
                                </DockPanel>
                                <TextBlock x:Name="Marker"
                                           Grid.Row="1"
                                           Text="{Binding Marker}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding OutsideMonth}"
                                         Value="True">
                                <Setter TargetName="Cell"
                                        Property="Opacity"
                                        Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}"
                                         Value="True">
                                <Setter TargetName="Cell"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRest}"
                                         Value="True">
                                <Setter TargetName="Marker"
                                        Property="FontWeight"
                                        Value="Bold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <ScrollViewer Grid.Row="0"
                      Grid.Column="1"
                      Margin="10,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" />
        </ScrollViewer>
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{DynamicResource calendar_settings}"
                    Margin="0,0,6,0"
                    Click="Settings_Click" />
            <Button Content="{DynamicResource calendar_close}"
                    IsCancel="True"
                    IsDefault="False" />
        </StackPanel>
    </Grid>
</Window>
