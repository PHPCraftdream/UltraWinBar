<Window x:Class="UltraWinBar.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource calendar_title}"
        Height="800"
        Width="1240"
        MinHeight="640"
        MinWidth="960"
        FontSize="15"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="{DynamicResource flow_direction}"
        Style="{DynamicResource PropertiesWindow}"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="-1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="CaptionButton"
                   TargetType="{x:Type Button}">
                <Setter Property="OverridesDefaultStyle"
                        Value="True" />
                <Setter Property="Focusable"
                        Value="False" />
                <Setter Property="Width"
                        Value="46" />
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Surface"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Surface"
                                            Property="Background"
                                            Value="#80F43F5E" />
                                </Trigger>
                                <Trigger Property="IsPressed"
                                         Value="True">
                                    <Setter TargetName="Surface"
                                            Property="Background"
                                            Value="#B3F43F5E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DetailRow"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="BorderBrush"
                        Value="Transparent" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="6" />
                <Setter Property="Padding"
                        Value="10,6" />
                <Setter Property="Margin"
                        Value="0,1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource ListRowHover}" />
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource ListRowHoverEdge}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type Button}"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinHeight"
                        Value="32" />
                <Setter Property="MinWidth"
                        Value="44" />
                <Setter Property="Padding"
                        Value="10,0" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>
            <!-- A memorial candle with its flame and glow (a yahrzeit): in the cells and before each name of the day. -->
            <Canvas x:Key="YahrzeitCandleIcon"
                    x:Shared="False"
                    Width="18"
                    Height="26"
                    IsHitTestVisible="False">
                    <Ellipse Canvas.Left="0"
                             Canvas.Top="0"
                             Width="18"
                             Height="18">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#AAFDE68A" Offset="0" />
                                <GradientStop Color="#40FBBF24" Offset="0.45" />
                                <GradientStop Color="#00FBBF24" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Path Canvas.Left="6"
                          Canvas.Top="3"
                          Data="M3,0 C4.6,2.6 6,4.4 6,6.6 C6,8.6 4.6,10 3,10 C1.4,10 0,8.6 0,6.6 C0,4.4 1.4,2.6 3,0 Z">
                        <Path.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.75" Center="0.5,0.7" RadiusX="0.6" RadiusY="0.6">
                                <GradientStop Color="#FFFFFBEB" Offset="0" />
                                <GradientStop Color="#FFFDE047" Offset="0.4" />
                                <GradientStop Color="#FFF97316" Offset="1" />
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Rectangle Canvas.Left="8.6"
                               Canvas.Top="12.5"
                               Width="0.8"
                               Height="2"
                               Fill="#FF57534E" />
                    <Rectangle Canvas.Left="5"
                               Canvas.Top="14.5"
                               Width="8"
                               Height="11"
                               RadiusX="1.2"
                               RadiusY="1.2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFE7E5E4" Offset="0" />
                                <GradientStop Color="#FFFFFFFF" Offset="0.45" />
                                <GradientStop Color="#FFD6D3D1" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
            </Canvas>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource ModernGlass}"
            BorderBrush="{DynamicResource ModernGlassBorder}"
            BorderThickness="0,0,0,1">
        <DockPanel>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CaptionButton}"
                    Content="&#x2715;"
                    ToolTip="{DynamicResource calendar_close}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Close_Click" />
            <!-- The settings: a gear beside the close button (Segoe MDL2 Assets, the Windows icon font). -->
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE713;"
                    FontFamily="Segoe MDL2 Assets"
                    ToolTip="{DynamicResource calendar_settings}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="Settings_Click" />
            <Border DockPanel.Dock="Left"
                    Width="3"
                    Height="14"
                    Margin="12,0,8,0"
                    CornerRadius="2"
                    Background="{DynamicResource ModernAccent}" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Border>
    <Grid Grid.Row="1"
          Margin="9,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"
                              MinWidth="520" />
            <ColumnDefinition Width="440" />
        </Grid.ColumnDefinitions>
        <!-- The month row, over the whole width: the civil month by the left arrow, the Hebrew ones by the right,
             the chosen day's Hebrew date and its week's portion in the middle. -->
        <DockPanel Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,10">
            <Button x:Name="PreviousButton"
                    DockPanel.Dock="Left"
                    Content="&#x25C0;"
                    ToolTip="{DynamicResource calendar_previous_month}"
                    Click="Previous_Click" />
            <Button x:Name="NextButton"
                    DockPanel.Dock="Right"
                    Content="&#x25B6;"
                    ToolTip="{DynamicResource calendar_next_month}"
                    Click="Next_Click" />
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource calendar_today}"
                    Margin="0,0,6,0"
                    Click="Today_Click" />
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MonthTitle"
                           Grid.Column="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="20"
                           FontWeight="Bold" />
                <StackPanel Grid.Column="1"
                            Margin="12,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PortionTitle"
                               HorizontalAlignment="Center"
                               FontSize="17"
                               FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="HebrewMonthTitle"
                           Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FlowDirection="LeftToRight"
                           FontSize="20"
                           FontWeight="Bold" />
            </Grid>
        </DockPanel>
        <Grid Grid.Row="1"
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid x:Name="WeekdayHeader"
                         Grid.Row="1"
                         Columns="7" />
            <ListBox x:Name="MonthList"
                     Grid.Row="2"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="MonthList_SelectionChanged"
                     PreviewKeyDown="MonthList_PreviewKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"
                                     Rows="6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="Margin"
                                Value="1" />
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch" />
                        <Setter Property="VerticalContentAlignment"
                                Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Cell"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="6,4"
                                ToolTip="{Binding Tooltip}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- The Hebrew date at the top right, the civil one at the bottom left (muted); between them the
                                     week's portion as an accent badge and the special days as blocks colored by their kind. -->
                                <!-- A yahrzeit on the day: a memorial candle with its flame and glow, at the top left. -->
                                <ContentControl x:Name="YahrzeitCandle"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="-2,-2,0,0"
                                                Focusable="False"
                                                IsHitTestVisible="False"
                                                Content="{StaticResource YahrzeitCandleIcon}"
                                                Visibility="Collapsed" />
                                <TextBlock Grid.Row="0"
                                           HorizontalAlignment="Right"
                                           Text="{Binding HebrewLabel}"
                                           Foreground="{DynamicResource ModernTextStrong}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <StackPanel Grid.Row="1"
                                            Margin="0,3"
                                            VerticalAlignment="Top">
                                    <Border x:Name="PortionBadge"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,2"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Background="{DynamicResource ModernAccentSoft}"
                                            BorderBrush="{DynamicResource ModernAccent}"
                                            BorderThickness="2,0,0,0">
                                        <TextBlock Text="{Binding Portion}"
                                                   Foreground="{DynamicResource ModernAccent}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Events}"
                                                  Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Chip"
                                                        Margin="0,0,0,2"
                                                        Padding="6,1"
                                                        CornerRadius="4"
                                                        Background="#2E38BDF8"
                                                        BorderBrush="#9938BDF8"
                                                        BorderThickness="2,0,0,0">
                                                    <TextBlock x:Name="ChipText"
                                                               Text="{Binding Name}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="YomTov">
                                                        <Setter TargetName="Chip" Property="Background" Value="#38FB7185" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#CCFB7185" />
                                                        <Setter TargetName="ChipText" Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="CholHamoed">
                                                        <Setter TargetName="Chip" Property="Background" Value="#26FB7185" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#99FB7185" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Fast">
                                                        <Setter TargetName="Chip" Property="Background" Value="#2694A3B8" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#9994A3B8" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Minor">
                                                        <Setter TargetName="Chip" Property="Background" Value="#2EFBBF24" />
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="#B3FBBF24" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <DockPanel Grid.Row="2">
                                    <TextBlock HorizontalAlignment="Left"
                                               Text="{Binding GregorianLabel}"
                                               Foreground="{DynamicResource ModernTextMuted}"
                                               FontSize="13" />
                                </DockPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding OutsideMonth}"
                                         Value="True">
                                <Setter TargetName="Cell"
                                        Property="Opacity"
                                        Value="0.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}"
                                         Value="True">
                                <Setter TargetName="Cell"
                                        Property="BorderBrush"
                                        Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Portion}"
                                         Value="{x:Null}">
                                <Setter TargetName="PortionBadge"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasYahrzeit}"
                                         Value="True">
                                <Setter TargetName="YahrzeitCandle"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <ScrollViewer Grid.Row="1"
                      Grid.Column="1"
                      Margin="10,0,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" />
        </ScrollViewer>
    </Grid>
    </Grid>
</Window>
