<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Icons shared by the calendar and the clock. -->
    <!-- A memorial candle with its flame and glow (a yahrzeit): in the cells and before each name of the day. -->
    <Canvas x:Key="YahrzeitCandleIcon"
            x:Shared="False"
            Width="18"
            Height="26"
            IsHitTestVisible="False">
            <Ellipse Canvas.Left="0"
                     Canvas.Top="0"
                     Width="18"
                     Height="18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <!-- A saturated amber glow: a pale one disappeared on the light theme's glass. -->
                        <GradientStop Color="#E6FBBF24" Offset="0" />
                        <GradientStop Color="#80F59E0B" Offset="0.45" />
                        <GradientStop Color="#00F59E0B" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Canvas.Left="6"
                  Canvas.Top="3"
                  Data="M3,0 C4.6,2.6 6,4.4 6,6.6 C6,8.6 4.6,10 3,10 C1.4,10 0,8.6 0,6.6 C0,4.4 1.4,2.6 3,0 Z"
                  Stroke="#FFC2410C"
                  StrokeThickness="0.7">
                <Path.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.75" Center="0.5,0.7" RadiusX="0.6" RadiusY="0.6">
                        <GradientStop Color="#FFFFFBEB" Offset="0" />
                        <GradientStop Color="#FFFDE047" Offset="0.4" />
                        <GradientStop Color="#FFEA580C" Offset="1" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>
            <Rectangle Canvas.Left="8.6"
                       Canvas.Top="12.5"
                       Width="0.8"
                       Height="2"
                       Fill="#FF57534E" />
            <Rectangle Canvas.Left="5"
                       Canvas.Top="14.5"
                       Width="8"
                       Height="11"
                       RadiusX="1.2"
                       RadiusY="1.2"
                       Stroke="#FF78716C"
                       StrokeThickness="0.8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFE7E5E4" Offset="0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.45" />
                        <GradientStop Color="#FFD6D3D1" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
    </Canvas>
    <!-- The tree of the ten sefirot (the counting of the Omer goes through their 49 combinations): the paths in the color
         of the text, the sefirot in the accent. -->
    <Canvas x:Key="OmerIcon"
            x:Shared="False"
            Width="14"
            Height="27"
            IsHitTestVisible="False">
        <Path Data="M7,2 L7,15 M7,15 L7,21 M7,21 L7,25 M2,6.5 L2,12.5 M2,12.5 L2,18.5 M12,6.5 L12,12.5 M12,12.5 L12,18.5 M2,6.5 L12,6.5 M2,12.5 L12,12.5 M2,18.5 L12,18.5 M7,2 L2,6.5 M7,2 L12,6.5 M2,6.5 L7,15 M12,6.5 L7,15 M2,12.5 L7,15 M12,12.5 L7,15 M2,18.5 L7,15 M12,18.5 L7,15 M2,18.5 L7,21 M12,18.5 L7,21 M2,18.5 L7,25 M12,18.5 L7,25" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.7" Opacity="0.6" />
        <Ellipse Canvas.Left="5.1" Canvas.Top="0.1" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="0.1" Canvas.Top="4.6" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="10.1" Canvas.Top="4.6" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="0.1" Canvas.Top="10.6" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="10.1" Canvas.Top="10.6" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="5.1" Canvas.Top="13.1" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="0.1" Canvas.Top="16.6" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="10.1" Canvas.Top="16.6" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="5.1" Canvas.Top="19.1" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
        <Ellipse Canvas.Left="5.1" Canvas.Top="23.1" Width="3.8" Height="3.8" Fill="{DynamicResource ModernAccent}" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.5" />
    </Canvas>
    <!-- A hanukkiah: eight candles on a bar and the shamash raised in the middle, the metal in the color of the text. -->
    <RadialGradientBrush x:Key="ChanukiahFlame" GradientOrigin="0.5,0.75" Center="0.5,0.7" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="#FFFFFBEB" Offset="0" />
        <GradientStop Color="#FFFDE047" Offset="0.4" />
        <GradientStop Color="#FFEA580C" Offset="1" />
    </RadialGradientBrush>
    <Canvas x:Key="ChanukiahIcon" x:Shared="False" Width="26" Height="22" IsHitTestVisible="False">
        <Rectangle Canvas.Left="8" Canvas.Top="19.6" Width="10" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource ClockForeground}" Opacity="0.85" />
        <Rectangle Canvas.Left="12.4" Canvas.Top="8.5" Width="1.2" Height="11.5" Fill="{DynamicResource ClockForeground}" Opacity="0.85" />
        <Rectangle Canvas.Left="1" Canvas.Top="11.2" Width="24" Height="1.3" RadiusX="0.6" RadiusY="0.6" Fill="{DynamicResource ClockForeground}" Opacity="0.85" />
        <Rectangle Canvas.Left="1.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="1" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="4.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="4" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="7.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="7" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="10.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="10" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="14.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="14" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="17.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="17" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="20.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="20" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="23.3" Canvas.Top="7.6" Width="1.4" Height="3.6" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="23" Canvas.Top="3.8" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
        <Rectangle Canvas.Left="12.3" Canvas.Top="4" Width="1.4" Height="4.5" Fill="#FFF5F5F4" Stroke="{DynamicResource ClockForeground}" StrokeThickness="0.3" />
        <Path Canvas.Left="12" Canvas.Top="0.2" Data="M1,0 C1.7,1.1 2,1.8 2,2.5 C2,3.2 1.5,3.6 1,3.6 C0.5,3.6 0,3.2 0,2.5 C0,1.8 0.3,1.1 1,0 Z" Fill="{StaticResource ChanukiahFlame}" />
    </Canvas>
</ResourceDictionary>
