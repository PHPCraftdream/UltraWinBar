<UserControl x:Class="UltraWinBar.Controls.ClockZonesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utilities="clr-namespace:UltraWinBar.Utilities">
    <!-- The time zones of the clock: the main one (the computer's unless another is chosen), a second and a third, each
         with a check box that says whether the clock names it next to its time, and a place for its times of the day. -->
    <StackPanel Orientation="Vertical">
        <Label Content="{DynamicResource zones_heading}"
               FontWeight="SemiBold"
               Margin="0,6,0,2" />
        <Label Content="{DynamicResource zone_main}"
               Target="{Binding ElementName=MainBox}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="MainBox"
                      utilities:ComboSearch.IsEnabled="True"
                      Width="Auto"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="Display"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Id"
                      SelectionChanged="MainBox_SelectionChanged" />
            <CheckBox Grid.Column="1"
                      Margin="10,5,0,5"
                      Content="{DynamicResource zone_show_name}"
                      IsChecked="{Binding ShowMainZoneName, UpdateSourceTrigger=PropertyChanged}" />
            <!-- Removes the zone itself (the main one goes back to the computer's); the place has its own Clear. -->
            <Button Grid.Column="2"
                    Margin="6,0,0,0"
                    Content="{DynamicResource zone_clear}"
                    Click="MainZoneClear_Click" />
        </Grid>
        <!-- The name the clock shows instead of the zone's place's; empty keeps the place's. -->
        <Grid ToolTip="{DynamicResource zone_label_hint}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label VerticalAlignment="Center"
                   Content="{DynamicResource zone_label}"
                   Target="{Binding ElementName=MainLabelBox}" />
            <TextBox x:Name="MainLabelBox"
                     Grid.Column="1"
                     Margin="6,2,0,2"
                     VerticalAlignment="Center"
                     MaxLength="40"
                     Text="{Binding MainZoneLabel, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid ToolTip="{DynamicResource hebrew_place_hint}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label VerticalAlignment="Center"
                   Content="{DynamicResource zone_place}" />
            <TextBlock x:Name="MainPlaceText"
                       Grid.Column="1"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2"
                    Content="{DynamicResource hebrew_place_choose}"
                    Click="MainPlaceChoose_Click" />
            <Button Grid.Column="3"
                    Content="{DynamicResource hebrew_place_clear}"
                    Click="MainPlaceClear_Click" />
        </Grid>
        <Label Content="{DynamicResource zone_second}"
               Target="{Binding ElementName=SecondBox}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SecondBox"
                      utilities:ComboSearch.IsEnabled="True"
                      Width="Auto"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="Display"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Id"
                      SelectionChanged="SecondBox_SelectionChanged" />
            <CheckBox Grid.Column="1"
                      Margin="10,5,0,5"
                      Content="{DynamicResource zone_show_name}"
                      IsChecked="{Binding ShowSecondZoneName, UpdateSourceTrigger=PropertyChanged}" />
            <!-- Removes the zone itself (the main one goes back to the computer's); the place has its own Clear. -->
            <Button Grid.Column="2"
                    Margin="6,0,0,0"
                    Content="{DynamicResource zone_clear}"
                    Click="SecondZoneClear_Click" />
        </Grid>
        <!-- The name the clock shows instead of the zone's place's; empty keeps the place's. -->
        <Grid ToolTip="{DynamicResource zone_label_hint}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label VerticalAlignment="Center"
                   Content="{DynamicResource zone_label}"
                   Target="{Binding ElementName=SecondLabelBox}" />
            <TextBox x:Name="SecondLabelBox"
                     Grid.Column="1"
                     Margin="6,2,0,2"
                     VerticalAlignment="Center"
                     MaxLength="40"
                     Text="{Binding SecondZoneLabel, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid ToolTip="{DynamicResource hebrew_place_hint}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label VerticalAlignment="Center"
                   Content="{DynamicResource zone_place}" />
            <TextBlock x:Name="SecondPlaceText"
                       Grid.Column="1"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2"
                    Content="{DynamicResource hebrew_place_choose}"
                    Click="SecondPlaceChoose_Click" />
            <Button Grid.Column="3"
                    Content="{DynamicResource hebrew_place_clear}"
                    Click="SecondPlaceClear_Click" />
        </Grid>
        <Label Content="{DynamicResource zone_third}"
               Target="{Binding ElementName=ThirdBox}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ThirdBox"
                      utilities:ComboSearch.IsEnabled="True"
                      Width="Auto"
                      HorizontalAlignment="Stretch"
                      DisplayMemberPath="Display"
                      IsTextSearchEnabled="True"
                      TextSearch.TextPath="Id"
                      SelectionChanged="ThirdBox_SelectionChanged" />
            <CheckBox Grid.Column="1"
                      Margin="10,5,0,5"
                      Content="{DynamicResource zone_show_name}"
                      IsChecked="{Binding ShowThirdZoneName, UpdateSourceTrigger=PropertyChanged}" />
            <!-- Removes the zone itself (the main one goes back to the computer's); the place has its own Clear. -->
            <Button Grid.Column="2"
                    Margin="6,0,0,0"
                    Content="{DynamicResource zone_clear}"
                    Click="ThirdZoneClear_Click" />
        </Grid>
        <!-- The name the clock shows instead of the zone's place's; empty keeps the place's. -->
        <Grid ToolTip="{DynamicResource zone_label_hint}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label VerticalAlignment="Center"
                   Content="{DynamicResource zone_label}"
                   Target="{Binding ElementName=ThirdLabelBox}" />
            <TextBox x:Name="ThirdLabelBox"
                     Grid.Column="1"
                     Margin="6,2,0,2"
                     VerticalAlignment="Center"
                     MaxLength="40"
                     Text="{Binding ThirdZoneLabel, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <Grid ToolTip="{DynamicResource hebrew_place_hint}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label VerticalAlignment="Center"
                   Content="{DynamicResource zone_place}" />
            <TextBlock x:Name="ThirdPlaceText"
                       Grid.Column="1"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2"
                    Content="{DynamicResource hebrew_place_choose}"
                    Click="ThirdPlaceChoose_Click" />
            <Button Grid.Column="3"
                    Content="{DynamicResource hebrew_place_clear}"
                    Click="ThirdPlaceClear_Click" />
        </Grid>
    </StackPanel>
</UserControl>
