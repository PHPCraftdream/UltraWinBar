<UserControl x:Class="UltraWinBar.Controls.Clock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MouseLeftButtonDown="Clock_OnMouseLeftButtonDown"
             MouseLeftButtonUp="Clock_OnMouseLeftButtonUp"
             MouseDoubleClick="Clock_OnMouseDoubleClick"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             Template="{DynamicResource ClockTemplateKey}">
    <UserControl.Resources>
        <ControlTemplate x:Key="HebrewClockTemplate" TargetType="UserControl">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{DynamicResource Clock}" Margin="4,1"
                               Text="{Binding TimeText}" />
                    <TextBlock Grid.Row="1" Style="{DynamicResource Clock}" Margin="4,1"
                               Text="{Binding WeekdayText}" />
                    <TextBlock x:Name="HebrewDate" Grid.Row="2" Style="{DynamicResource Clock}" Margin="4,1"
                               FlowDirection="LeftToRight" Text="{Binding HebrewDateText}" />
                    <TextBlock x:Name="OrdinaryDate" Grid.Row="3" Style="{DynamicResource Clock}" Margin="4,1"
                               Text="{Binding OrdinaryDateText}" />
                </Grid>
            </Viewbox>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Horizontal">
                    <Setter TargetName="HebrewDate" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="HebrewDate" Property="Grid.Row" Value="0"/>
                    <Setter TargetName="OrdinaryDate" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="OrdinaryDate" Property="Grid.Row" Value="1"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <UserControl.ToolTip>
        <TextBlock Text="{Binding Path=Now, StringFormat=D, Mode=OneWay}"
                   Name="ClockTip" />
    </UserControl.ToolTip>
</UserControl>
