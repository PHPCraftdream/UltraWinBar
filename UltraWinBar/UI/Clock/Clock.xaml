<UserControl x:Class="UltraWinBar.Controls.Clock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UltraWinBar.Controls"
             MouseLeftButtonDown="Clock_OnMouseLeftButtonDown"
             MouseLeftButtonUp="Clock_OnMouseLeftButtonUp"
             MouseDoubleClick="Clock_OnMouseDoubleClick"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             Template="{DynamicResource ClockTemplateKey}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/UltraWinBar;component/UI/Clock/Calendar/CalendarIcons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <!-- The clock's own time and, under it, the times in the second and the third time zone (those chosen). -->
        <ControlTemplate x:Key="TwoZoneClockTemplate" TargetType="UserControl">
            <StackPanel Orientation="Vertical">
                <Border Style="{DynamicResource ClockZoneFrame}">
                    <TextBlock Style="{DynamicResource Clock}" Text="{Binding TimeText}" />
                </Border>
                <Border Style="{DynamicResource ClockZoneFrame}" Visibility="{Binding SecondTimeVisibility}">
                    <TextBlock Style="{DynamicResource Clock}" Text="{Binding SecondTimeText}" />
                </Border>
                <Border Style="{DynamicResource ClockZoneFrame}" Visibility="{Binding ThirdTimeVisibility}">
                    <TextBlock Style="{DynamicResource Clock}" Text="{Binding ThirdTimeText}" />
                </Border>
            </StackPanel>
        </ControlTemplate>
        <ControlTemplate x:Key="HebrewClockTemplate" TargetType="UserControl">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Border Style="{DynamicResource ClockZoneFrame}">
                            <TextBlock Style="{DynamicResource Clock}" Margin="4,0"
                                   Text="{Binding TimeText}" />
                        </Border>
                        <!-- The times in the second and the third time zone, when chosen. -->
                        <Border Style="{DynamicResource ClockZoneFrame}" Visibility="{Binding SecondTimeVisibility}">
                            <TextBlock Style="{DynamicResource Clock}" Margin="4,0"
                                   Text="{Binding SecondTimeText}" />
                        </Border>
                        <Border Style="{DynamicResource ClockZoneFrame}" Visibility="{Binding ThirdTimeVisibility}">
                            <TextBlock Style="{DynamicResource Clock}" Margin="4,0"
                                   Text="{Binding ThirdTimeText}" />
                        </Border>
                    </StackPanel>
                    <!-- The weekday, after a candle when the Hebrew day has a yahrzeit, during the Omer the tree of the sefirot with its day, during Hanukkah a hanukkiah with the candles of the evening. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="4,0">
                        <Viewbox Height="15" Margin="0,0,3,0" VerticalAlignment="Center" Visibility="{Binding YahrzeitVisibility}">
                            <ContentControl Focusable="False" IsHitTestVisible="False" Content="{DynamicResource YahrzeitCandleIcon}" />
                        </Viewbox>
                        <TextBlock Style="{DynamicResource Clock}" Margin="0" Text="{Binding WeekdayText}" />
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0" Visibility="{Binding OmerVisibility}">
                            <Viewbox Height="18" Margin="0,0,2,0" VerticalAlignment="Center">
                                <ContentControl Focusable="False" IsHitTestVisible="False" Content="{DynamicResource OmerIcon}" />
                            </Viewbox>
                            <TextBlock Style="{DynamicResource Clock}" Margin="0" Text="{Binding OmerText}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0" Visibility="{Binding ChanukahVisibility}">
                            <Viewbox Height="16" Margin="0,0,2,0" VerticalAlignment="Center">
                                <ContentControl Focusable="False" IsHitTestVisible="False" Content="{DynamicResource ChanukiahIcon}" />
                            </Viewbox>
                            <TextBlock Style="{DynamicResource Clock}" Margin="0" Text="{Binding ChanukahText}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- The pointer over the Hebrew date lights up a frame of running lights around it. -->
                    <Grid x:Name="HebrewDateHost" Grid.Row="2" Background="Transparent" Cursor="Hand">
                        <TextBlock x:Name="HebrewDate" Style="{DynamicResource Clock}" Margin="4,0"
                                   FlowDirection="LeftToRight" Text="{Binding HebrewDateText}" />
                        <local:MarqueeFrame x:Name="HebrewDateLights" IsHitTestVisible="False"
                                            Foreground="{Binding Foreground, ElementName=HebrewDate}" />
                    </Grid>
                    <TextBlock x:Name="OrdinaryDate" Grid.Row="3" Style="{DynamicResource Clock}" Margin="4,0"
                               Text="{Binding OrdinaryDateText}" />
                </Grid>
            </Viewbox>
            <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Horizontal">
                    <Setter TargetName="HebrewDateHost" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="HebrewDateHost" Property="Grid.Row" Value="0"/>
                    <Setter TargetName="OrdinaryDate" Property="Grid.Column" Value="1"/>
                    <Setter TargetName="OrdinaryDate" Property="Grid.Row" Value="1"/>
                </DataTrigger>
                <Trigger SourceName="HebrewDateHost" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HebrewDateLights" Property="IsRunning" Value="True"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- On a vertical panel: each zone in its frame, the weekday with the Hebrew date in one, the civil date in its own. -->
        <ControlTemplate x:Key="HebrewClockVerticalTemplate" TargetType="UserControl">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <StackPanel>
                    <Border Style="{DynamicResource ClockZoneFrame}">
                        <TextBlock Style="{DynamicResource Clock}" Margin="4,0" Text="{Binding TimeText}" />
                    </Border>
                    <Border Style="{DynamicResource ClockZoneFrame}" Visibility="{Binding SecondTimeVisibility}">
                        <TextBlock Style="{DynamicResource Clock}" Margin="4,0" Text="{Binding SecondTimeText}" />
                    </Border>
                    <Border Style="{DynamicResource ClockZoneFrame}" Visibility="{Binding ThirdTimeVisibility}">
                        <TextBlock Style="{DynamicResource Clock}" Margin="4,0" Text="{Binding ThirdTimeText}" />
                    </Border>
                    <!-- The whole Hebrew block (weekday and date, with its frame) opens the calendar: the hand and the
                         running lights cover all of it. -->
                    <Grid x:Name="HebrewDateHost" Background="Transparent" Cursor="Hand">
                        <Border Style="{DynamicResource ClockZoneFrame}">
                            <StackPanel>
                                <!-- The weekday, after a candle when the Hebrew day has a yahrzeit, during the Omer the tree of the sefirot with its day, during Hanukkah a hanukkiah with the candles of the evening. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
                                    <Viewbox Height="15" Margin="0,0,3,0" VerticalAlignment="Center" Visibility="{Binding YahrzeitVisibility}">
                                        <ContentControl Focusable="False" IsHitTestVisible="False" Content="{DynamicResource YahrzeitCandleIcon}" />
                                    </Viewbox>
                                    <TextBlock Style="{DynamicResource Clock}" Margin="0" Text="{Binding WeekdayText}" />
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0" Visibility="{Binding OmerVisibility}">
                                        <Viewbox Height="18" Margin="0,0,2,0" VerticalAlignment="Center">
                                            <ContentControl Focusable="False" IsHitTestVisible="False" Content="{DynamicResource OmerIcon}" />
                                        </Viewbox>
                                        <TextBlock Style="{DynamicResource Clock}" Margin="0" Text="{Binding OmerText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0" Visibility="{Binding ChanukahVisibility}">
                                        <Viewbox Height="16" Margin="0,0,2,0" VerticalAlignment="Center">
                                            <ContentControl Focusable="False" IsHitTestVisible="False" Content="{DynamicResource ChanukiahIcon}" />
                                        </Viewbox>
                                        <TextBlock Style="{DynamicResource Clock}" Margin="0" Text="{Binding ChanukahText}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="HebrewDate" Style="{DynamicResource Clock}" Margin="4,0"
                                           FlowDirection="LeftToRight" Text="{Binding HebrewDateText}" />
                            </StackPanel>
                        </Border>
                        <local:MarqueeFrame x:Name="HebrewDateLights" IsHitTestVisible="False"
                                            Foreground="{Binding Foreground, ElementName=HebrewDate}" />
                    </Grid>
                    <Border Style="{DynamicResource ClockZoneFrame}">
                        <TextBlock x:Name="OrdinaryDate" Style="{DynamicResource Clock}" Margin="4,0" Text="{Binding OrdinaryDateText}" />
                    </Border>
                </StackPanel>
            </Viewbox>
            <ControlTemplate.Triggers>
                <Trigger SourceName="HebrewDateHost" Property="IsMouseOver" Value="True">
                    <Setter TargetName="HebrewDateLights" Property="IsRunning" Value="True"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
</UserControl>
