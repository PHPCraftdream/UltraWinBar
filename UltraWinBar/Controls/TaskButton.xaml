<UserControl x:Class="UltraWinBar.Controls.TaskButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:UltraWinBar.Converters"
             xmlns:controls="clr-namespace:UltraWinBar.Controls"
             xmlns:utilities="clr-namespace:UltraWinBar.Utilities"
             Loaded="TaskButton_OnLoaded"
             Unloaded="TaskButton_OnUnloaded">
    <UserControl.Resources>
        <ControlTemplate x:Key="PinnedTaskTemplate" TargetType="Button">
            <Grid x:Name="PinnedHitArea">
            <Border x:Name="PinnedBody" Margin="3" Padding="2" CornerRadius="3" BorderThickness="1"
                    BorderBrush="{DynamicResource FlatBorder}" Background="{DynamicResource FlatTask}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical" />
                        <Condition Binding="{Binding IsLauncher, RelativeSource={RelativeSource AncestorType=controls:TaskButton}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PinnedHitArea" Property="Background" Value="Transparent" />
                </MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="PinnedBody" Property="Background" Value="{DynamicResource FlatHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter TargetName="PinnedBody" Property="Background" Value="{DynamicResource FlatActive}" />
                    <Setter TargetName="PinnedBody" Property="BorderBrush" Value="#90FFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Flashing">
                    <Setter TargetName="PinnedBody" Property="Background" Value="{DynamicResource TaskButtonBackgroundFlashing}" />
                </DataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="PinnedBody" Property="Background" Value="{DynamicResource FlatPressed}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <converters:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
        <converters:ToolTipHorizontalOffsetConverter x:Key="toolTipHorizontalOffsetConverter" />
        <converters:ToolTipVerticalOffsetConverter x:Key="toolTipVerticalOffsetConverter" />
        <converters:ToolTipPlacementConverter x:Key="toolTipPlacementConverter" />
        <converters:TaskLabelConverter x:Key="taskLabelConverter" />
    </UserControl.Resources>
    <Grid>
    <Button Name="AppButton"
            Click="AppButton_OnClick"
             MouseUp="AppButton_OnMouseUp"
             MouseWheel="AppButton_OnMouseWheel"
             PreviewMouseDown="AppButton_OnPreviewMouseDown"
             PreviewMouseMove="AppButton_OnPreviewMouseMove"
             PreviewMouseLeftButtonUp="AppButton_OnPreviewMouseLeftButtonUp"
             ContextMenuOpening="AppButton_OnContextMenuOpening"
            DragEnter="AppButton_OnDragEnter"
            DragLeave="AppButton_OnDragLeave"
            ToolTipService.ShowDuration="60000">
        <Grid x:Name="TaskContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TaskGlyph" Source="{Binding Path=Icon, Mode=OneWay}"
                   Width="20" Height="20" Stretch="Uniform"
                   Grid.Column="0"
                   Style="{DynamicResource TaskIcon}" />
            <Image Source="{Binding Path=OverlayIcon, Mode=OneWay}"
                   Grid.Column="0"
                   Style="{DynamicResource TaskOverlayIcon}"
                   Visibility="{Binding Source={x:Static utilities:Settings.Instance}, Path=ShowTaskBadges, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource boolToVisibilityConverter}}" />
            <TextBlock x:Name="TaskText" Grid.Column="1"
                       Style="{DynamicResource TaskLabel}">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource taskLabelConverter}">
                        <Binding Path="Title" />
                        <Binding Path="ProgressValue" />
                        <Binding Path="ProgressState" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Grid>
        <Button.ContextMenu>
            <ContextMenu Opened="ContextMenu_OpenedOrClosed"
                         Closed="ContextMenu_OpenedOrClosed">
                <TextOptions.TextRenderingMode>
                    <Binding Source="{x:Static utilities:Settings.Instance}" Path="AllowFontSmoothingMenu" Converter="{StaticResource menuTextRenderingModeConverter}" />
                </TextOptions.TextRenderingMode>
                <MenuItem x:Name="PinMenuItem" Header="{DynamicResource pin_to_taskbar}" Click="PinMenuItem_OnClick" />
                <MenuItem x:Name="AllDesktopsMenuItem" Header="{DynamicResource app_all_desktops}" IsCheckable="True" Click="AllDesktops_OnClick" />
                <MenuItem x:Name="MoveWindowDesktopMenuItem" Header="{DynamicResource move_window_desktop}" />
                <MenuItem x:Name="MoveAppDesktopMenuItem" Header="{DynamicResource move_app_desktop}" />
                <MenuItem x:Name="PinnedWindowsMenuItem" Header="{DynamicResource pinned_app_windows}" Visibility="Collapsed" />
                <Separator />
                <MenuItem Header="{DynamicResource restore}"
                          Click="RestoreMenuItem_OnClick"
                          Name="RestoreMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x32;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource move}"
                          Click="MoveMenuItem_OnClick"
                          Name="MoveMenuItem" />
                <MenuItem Header="{DynamicResource size}"
                          Click="SizeMenuItem_OnClick"
                          Name="SizeMenuItem" />
                <MenuItem Header="{DynamicResource minimize}"
                          Click="MinimizeMenuItem_OnClick"
                          Name="MinimizeMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x30;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{DynamicResource maximize}"
                          Click="MaximizeMenuItem_OnClick"
                          Name="MaximizeMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x31;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{DynamicResource reset_task_assignment}"
                          Click="ResetTaskAssignmentMenuItem_OnClick"
                          Name="ResetTaskAssignmentMenuItem" />
                <Separator />
                <MenuItem Header="{DynamicResource end_task}"
                          Click="EndTaskMenuItem_OnClick"
                          Name="EndTaskMenuItem"
                          Visibility="{Binding Source={x:Static utilities:Settings.Instance}, Path=ShowEndTaskButton, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource boolToVisibilityConverter}}">
                </MenuItem>
                <MenuItem Header="{DynamicResource close}"
                          Click="CloseMenuItem_OnClick"
                          Name="CloseMenuItem">
                    <MenuItem.Icon>
                        <TextBlock FontFamily="Marlett"
                                   Text="&#x72;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
        <Button.ToolTip>
            <ToolTip>
                <ToolTip.Style>
                    <Style TargetType="ToolTip"
                           BasedOn="{StaticResource {x:Type ToolTip}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static utilities:Settings.Instance}, Path=ShowTaskThumbnails, UpdateSourceTrigger=PropertyChanged}"
                                                             Value="True">
                                <DataTrigger.Setters>
                                    <Setter Property="HorizontalOffset">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource toolTipHorizontalOffsetConverter}" UpdateSourceTrigger="PropertyChanged">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualWidth"/>
                                                <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="TaskbarScale"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="VerticalOffset">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource toolTipVerticalOffsetConverter}" UpdateSourceTrigger="PropertyChanged">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="PlacementTarget.ActualHeight"/>
                                                <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="TaskbarScale"/>
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Placement">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource toolTipPlacementConverter}" UpdateSourceTrigger="PropertyChanged">
                                                <Binding Source="{x:Static utilities:Settings.Instance}" Path="Edge"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToolTip">
                                                <ContentControl Style="{DynamicResource TaskButtonThumbnail}">
                                                    <controls:TaskThumbnail SourceWindowHandle="{Binding Path=Handle}"
                                                                            Title="{Binding Path=Title}"/>
                                                </ContentControl>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger.Setters>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToolTip.Style>
                <TextBlock Text="{Binding Path=Title}" />
            </ToolTip>
        </Button.ToolTip>
    </Button>
    </Grid>
</UserControl>
