<UserControl x:Class="UltraWinBar.Controls.StartButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <ToggleButton ToolTip="{DynamicResource StartButtonTip}"
                  Click="Start_OnClick"
                  DragEnter="Start_DragEnter"
                  DragLeave="Start_DragLeave"
                  PreviewMouseLeftButtonDown="Start_OnPreviewMouseLeftButtonDown"
                  MouseRightButtonUp="Start_OnMouseRightButtonUp"
                  Name="Start"
                  >
        <ToggleButton.Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource StartButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=Window}}" Value="Vertical">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ToggleButton.Style>
        <Image Style="{DynamicResource StartIcon}" />
    </ToggleButton>
</UserControl>
