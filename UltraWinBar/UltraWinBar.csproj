<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>UltraWinBar</AssemblyName>
    <RootNamespace>UltraWinBar</RootNamespace>
    <Product>UltraWinBar</Product>
    <Title>UltraWinBar</Title>
    <RollForward>LatestMajor</RollForward>
    <TargetFrameworks>net6.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>UltraWinBar.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>1.0.0.8</AssemblyVersion>
    <FileVersion>1.0.0.8</FileVersion>
    <ApplicationIcon>Resources\ultrawinbar.ico</ApplicationIcon>
    <Platforms>AnyCPU;x86;ARM64</Platforms>
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
	<RuntimeHostConfigurationOption Include="Switch.System.Windows.Media.EnableHardwareAccelerationInRdp" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
    <None Include="Languages\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
    <None Include="Themes\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
	<None Remove="Resources\desktop95-sm.png" />
	<None Remove="Resources\desktop95-lg.png" />
	<None Remove="Resources\help.png" />
    <None Remove="Resources\ultrawinbar.ico" />
    <None Remove="Resources\FlatControls.xaml" />
    <None Remove="Resources\shader_invert.ps" />
    <None Remove="Resources\start9x.png" />
    <None Remove="Languages\English.xaml" />
    <None Remove="Themes\System.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="gong-wpf-dragdrop" Version="3.1.1" />
    <PackageReference Include="ManagedShell" Version="0.0.358" />
  </ItemGroup>

  <ItemGroup>
	<Resource Include="Resources\desktop95-sm.png" />
	<Resource Include="Resources\desktop95-lg.png" />
	<Resource Include="Resources\help.png" />
    <Resource Include="Resources\shader_invert.ps" />
    <Resource Include="Resources\FlatControls.xaml" />
    <Resource Include="Resources\ultrawinbar.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <EmbeddedResource Include="Resources\HebrewMonths.json" LogicalName="UltraWinBar.Resources.HebrewMonths.json" />
    <Resource Include="Resources\start9x.png" />
  </ItemGroup>

</Project>
