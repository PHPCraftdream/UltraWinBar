    <SolidColorBrush x:Key="TrayVerticalBackground" Color="#cacbd9" />

    <SolidColorBrush x:Key="TrayToggleBorder" Color="#242424" />
    <SolidColorBrush x:Key="TrayToggleBackground" Color="#f8f8f8" />
    <SolidColorBrush x:Key="TrayToggleHoverBackground" Color="#ffffff" />
    <SolidColorBrush x:Key="TrayTogglePressedBackground" Color="#e0e0e0" />
    <DropShadowEffect x:Key="TrayToggleArrowOuterShadow" Color="#000000" BlurRadius="0" ShadowDepth="0" Direction="90" Opacity="0" />
    <DropShadowEffect x:Key="TrayToggleArrowShadow" Color="#585a73" BlurRadius="0" Opacity="0" ShadowDepth="0" Direction="270" />
    <SolidColorBrush x:Key="TrayToggleArrowPressed" Color="#ffffff" />
    <Thickness x:Key="TrayToggleArrowPadding" Left="4" Top="4" Right="7" Bottom="4" />

    <SolidColorBrush x:Key="TaskButtonTopBorder" Color="#a6a7b0" />
    <SolidColorBrush x:Key="TaskButtonLeftBorder" Color="#9495a2" />
    <SolidColorBrush x:Key="TaskButtonRightBorder" Color="#9495a2" />
    <SolidColorBrush x:Key="TaskButtonBottomBorder" Color="#8a8b98" />
    <SolidColorBrush x:Key="TaskButtonInnerLeftBorder" Color="#ffffff" />
    <SolidColorBrush x:Key="TaskButtonInnerRightBorder" Color="#ffffff" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomBorder" Color="#8a8b98" />
    <SolidColorBrush x:Key="TaskButtonBackground" Color="#cfd0df" />
