<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:system="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Windows XP Royale.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <system:Boolean x:Key="InvertSystemNotifyIcons">False</system:Boolean>

    <SolidColorBrush x:Key="TaskbarBackground" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TaskbarBackgroundTall" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TaskbarVerticalBackground" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TaskbarBorder" Color="#1f2639" />

    <SolidColorBrush x:Key="TaskbarUnlockedBorderTop" Color="#000000" />
    <SolidColorBrush x:Key="TaskbarUnlockedBottomBorder" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TaskbarUnlockedTopBorder" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TaskbarUnlockedLeftBorder" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TaskbarUnlockedRightBorder" Color="#2f3c4d" />

    <SolidColorBrush x:Key="TrayTopBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TrayBottomBorder" Color="Transparent" />
    <SolidColorBrush x:Key="TrayOuterBorderVertical" Color="Transparent" />
    <SolidColorBrush x:Key="TrayLeftBorder1" Color="Transparent" />
    <SolidColorBrush x:Key="TrayBackground" Color="#2f3c4d" />
    <SolidColorBrush x:Key="TrayVerticalBackground" Color="#2f3c4d" />

    <SolidColorBrush x:Key="TrayToggleOuterBorder" Color="#263147" />
    <SolidColorBrush x:Key="TrayToggleBorder" Color="#070c1a" />
    <SolidColorBrush x:Key="TrayToggleBorderHover" Color="#000000" />
    <SolidColorBrush x:Key="TrayToggleBackground" Color="#172134" />
    <SolidColorBrush x:Key="TrayToggleHoverBackground" Color="#00020a" />
    <SolidColorBrush x:Key="TrayTogglePressedBackground" Color="#01030c" />
    <DropShadowEffect x:Key="TrayToggleArrowOuterShadow" Color="Transparent" Opacity="0" BlurRadius="0" ShadowDepth="0" />
    <DropShadowEffect x:Key="TrayToggleArrowShadow" Color="#000000" BlurRadius="0" ShadowDepth="0" Opacity="0" />
    <SolidColorBrush x:Key="TrayToggleArrow" Color="#adbddb" />
    <SolidColorBrush x:Key="TrayToggleArrowPressed" Color="#8391ab" />

    <SolidColorBrush x:Key="TaskButtonTopBorder" Color="#58606b" />
    <SolidColorBrush x:Key="TaskButtonLeftBorder" Color="#2b3545" />
    <SolidColorBrush x:Key="TaskButtonRightBorder" Color="#2b3545" />
    <SolidColorBrush x:Key="TaskButtonBottomBorder" Color="#000d1d" />
    <SolidColorBrush x:Key="TaskButtonInnerLeftBorder" Color="#00000000" />
    <SolidColorBrush x:Key="TaskButtonInnerRightBorder" Color="#00000000" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomBorder" Color="#1e2637" />
    <SolidColorBrush x:Key="TaskButtonBackground" Color="#404e5e" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHighlight" Color="Transparent" />

    <SolidColorBrush x:Key="TaskButtonTopBorderHover" Color="#424b5e" />
    <SolidColorBrush x:Key="TaskButtonLeftBorderHover" Color="#354154" />
    <SolidColorBrush x:Key="TaskButtonRightBorderHover" Color="#354154" />
    <SolidColorBrush x:Key="TaskButtonBottomBorderHover" Color="#0d0625" />
    <SolidColorBrush x:Key="TaskButtonInnerLeftBorderHover" Color="#00000000" />
    <SolidColorBrush x:Key="TaskButtonInnerRightBorderHover" Color="#00000000" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomBorderHover" Color="#070c1e" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHover" Color="#4e5d6b" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHighlightHover" Color="Transparent" />

    <SolidColorBrush x:Key="TaskButtonTopBorderPressed" Color="#030305" />
    <SolidColorBrush x:Key="TaskButtonLeftBorderPressed" Color="#000615" />
    <SolidColorBrush x:Key="TaskButtonRightBorderPressed" Color="#000615" />
    <SolidColorBrush x:Key="TaskButtonBottomBorderPressed" Color="#354154" />
    <SolidColorBrush x:Key="TaskButtonInnerLeftBorderPressed" Color="#00000000" />
    <SolidColorBrush x:Key="TaskButtonInnerRightBorderPressed" Color="#00000000" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomBorderPressed" Color="#17202c" />
    <SolidColorBrush x:Key="TaskButtonBackgroundPressed" Color="#1a2332" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHighlightPressed" Color="Transparent" />

    <SolidColorBrush x:Key="TaskButtonTopBorderPressedHover" Color="#030310" />
    <SolidColorBrush x:Key="TaskButtonInnerLeftBorderPressedHover" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerRightBorderPressedHover" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerBottomBorderPressedHover" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBackgroundPressedHover" Color="#253140" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHighlightPressedHover" Color="Transparent" />

    <SolidColorBrush x:Key="TaskListScrollButtonBackgroundPressed" Color="#2e3947" />
    <SolidColorBrush x:Key="TaskListScrollArrow" Color="#adbddb" />

    <SolidColorBrush x:Key="TaskButtonBackgroundFlashing" Color="#b87732" />
    <SolidColorBrush x:Key="TaskButtonBackgroundHighlightFlashing" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonInnerLeftBorderFlashing" Color="Transparent" />
    <SolidColorBrush x:Key="TaskButtonBottomBorderFlashing" Color="#825427" />

    <SolidColorBrush x:Key="ToolbarThumbForeground" Color="#73777f" />

    <DropShadowEffect x:Key="StartLabelShadow" Color="#303611" Direction="315" ShadowDepth="0" BlurRadius="0" Opacity="0" />

    <SolidColorBrush x:Key="ClockForeground" Color="#ffffff" />
    <SolidColorBrush x:Key="InputLanguageBackground" Color="#5e80bc" />

    <DrawingImage x:Key="StartButtonImage">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="#E0E7EF" Geometry="M0,0 H9 V9 H0 Z M12,0 H21 V9 H12 Z M0,12 H9 V21 H0 Z M12,12 H21 V21 H12 Z" />
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="StartIcon" TargetType="Image"><Setter Property="Source" Value="{DynamicResource FlatStartIcon}" /><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Margin" Value="0" /></Style>
    <Style x:Key="StartButton" TargetType="ToggleButton" BasedOn="{StaticResource StartButton}">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template" Value="{DynamicResource FlatToggleTemplate}"></Setter>
    </Style>
</ResourceDictionary>
